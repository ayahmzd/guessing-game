# Generate the project README file.
.PHONY: all clean FORCE

all: README.md

README.md: FORCE
	@echo "# The Guessing Game" > README.md
	@echo "" >> README.md
	@echo "A Bash program that asks you to guess how many regular files are in the current directory." >> README.md
	@echo "" >> README.md
	@echo "## Project information" >> README.md
	@echo "" >> README.md
	@echo "- **Date and time generated:** $$(date '+%Y-%m-%d %H:%M:%S')" >> README.md
	@echo "- **Lines in guessinggame.sh:** $$(wc -l < guessinggame.sh | tr -d ' ')" >> README.md
	@echo "" >> README.md
	@echo "## How to run" >> README.md
	@echo "" >> README.md
	@echo '```bash' >> README.md
	@echo "bash guessinggame.sh" >> README.md
	@echo '```' >> README.md
	@echo "" >> README.md
	@echo "## How to generate this README" >> README.md
	@echo "" >> README.md
	@echo "Run \`make\` in the project directory. This file is generated by the Makefile." >> README.md

FORCE:

clean:
	rm -f README.md
